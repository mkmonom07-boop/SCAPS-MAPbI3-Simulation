*================================================================================
* SCAPS 1D 3.3.09 SIMULATION FILE FOR MAPbI3 PEROVSKITE SOLAR CELL
*================================================================================
* Based on Scientific Literature:
* Title: Enhanced Conversion Efficiency in MAPbI3 Perovskite Solar Cells 
*        through Parameters Optimization via SCAPS-1D Simulation
* Authors: Chaerin Son, Hyojung Son, Byoung-Seong Jeong
* Journal: Applied Sciences, 2024, Volume 14, Issue 6, Article 2390
* DOI: 10.3390/app14062390
* URL: https://doi.org/10.3390/app14062390
*
* Reference Publication Details:
* - Device structure: ITO/TiO2/MAPbI3/Cu2O/Au
* - Simulation tool: SCAPS-1D version 3.3.09
* - Operating temperature: 300 K
* - Light source: AM1.5G (1000 W/m²)
*================================================================================

*================================================================================
* SIMULATION GENERAL SETTINGS
*================================================================================
Version=3.3.09
Temperature=300
Mode=Steady state

*Mesh parameters
xmesh_exp=1.1

*================================================================================
* LAYER 1: FRONT CONTACT - ITO (Indium Tin Oxide)
*================================================================================
Layer=1
Layer1_name=ITO
Layer1_Vbi=0
Layer1_d=150
Layer1_Nc=1e20
Layer1_Nv=1e20
Layer1_mu_e=20
Layer1_mu_h=5
Layer1_tau_e=1e-8
Layer1_tau_h=1e-8
Layer1_W_l=0
Layer1_W_r=0
Layer1_type=Metal
Layer1_sn=1e7
Layer1_sp=1e7
Layer1_rel_perm=9
Layer1_defect_type=Neutral
Layer1_defect_density=1e14
Layer1_defect_energy=Ec-0.5

*================================================================================
* LAYER 2: ELECTRON TRANSPORT LAYER - TiO2 (Titanium Dioxide)
*================================================================================
Layer=2
Layer2_name=TiO2
Layer2_Vbi=0.9
Layer2_d=100
Layer2_Nc=1e20
Layer2_Nv=1e20
Layer2_mu_e=20
Layer2_mu_h=10
Layer2_tau_e=1e-7
Layer2_tau_h=1e-7
Layer2_W_l=0
Layer2_W_r=0
Layer2_type=Semiconductor
Layer2_sn=1e7
Layer2_sp=1e7
Layer2_rel_perm=80
Layer2_defect_type=Neutral
Layer2_defect_density=1e14
Layer2_defect_energy=Ec-1.6
Layer2_Add_Nc=0
Layer2_Add_Nv=0
Layer2_Add_doping_type=n
Layer2_Add_N_doping=1e18
Layer2_composition=TiO2

*================================================================================
* LAYER 3: PEROVSKITE ABSORBER - MAPbI3 (Methylammonium Lead Iodide)
*================================================================================
Layer=3
Layer3_name=MAPbI3
Layer3_Vbi=1.2
Layer3_d=500
Layer3_Nc=2.2e18
Layer3_Nv=1.8e18
Layer3_mu_e=66
Layer3_mu_h=371
Layer3_tau_e=1e-7
Layer3_tau_h=1e-7
Layer3_W_l=0
Layer3_W_r=0
Layer3_type=Semiconductor
Layer3_sn=1e5
Layer3_sp=1e5
Layer3_rel_perm=30
Layer3_defect_type=Acceptor
Layer3_defect_density=1e16
Layer3_defect_energy=Ev+0.78
Layer3_Add_Nc=0
Layer3_Add_Nv=0
Layer3_Add_doping_type=p
Layer3_Add_N_doping=1e15
Layer3_composition=MAPbI3
Layer3_bandgap=1.55
Layer3_e_affinity=3.93

*================================================================================
* LAYER 4: HOLE TRANSPORT LAYER - Cu2O (Cuprous Oxide)
*================================================================================
Layer=4
Layer4_name=Cu2O
Layer4_Vbi=0.5
Layer4_d=100
Layer4_Nc=1e20
Layer4_Nv=1e20
Layer4_mu_e=1e-4
Layer4_mu_h=50
Layer4_tau_e=1e-8
Layer4_tau_h=1e-8
Layer4_W_l=0
Layer4_W_r=0
Layer4_type=Semiconductor
Layer4_sn=1e7
Layer4_sp=1e7
Layer4_rel_perm=10
Layer4_defect_type=Neutral
Layer4_defect_density=1e14
Layer4_defect_energy=Ev+1.5
Layer4_Add_Nc=0
Layer4_Add_Nv=0
Layer4_Add_doping_type=p
Layer4_Add_N_doping=1e18
Layer4_composition=Cu2O

*================================================================================
* LAYER 5: BACK CONTACT - Au (Gold)
*================================================================================
Layer=5
Layer5_name=Au
Layer5_Vbi=0
Layer5_d=100
Layer5_Nc=1e20
Layer5_Nv=1e20
Layer5_mu_e=20
Layer5_mu_h=5
Layer5_tau_e=1e-8
Layer5_tau_h=1e-8
Layer5_W_l=0
Layer5_W_r=0
Layer5_type=Metal
Layer5_sn=1e7
Layer5_sp=1e7
Layer5_rel_perm=1
Layer5_defect_type=Neutral
Layer5_defect_density=1e10

*================================================================================
* INTERFACE PARAMETERS (From Scientific References)
*================================================================================

*Interface 1: ITO/TiO2
Interface1_type=Donor
Interface1_N_interface_donor=1e11
Interface1_interface_energy_level=Ec-1.6

*Interface 2: TiO2/MAPbI3
Interface2_type=Acceptor
Interface2_N_interface_donor=1e10
Interface2_interface_energy_level=Ev+0.78

*Interface 3: MAPbI3/Cu2O
Interface3_type=Donor
Interface3_N_interface_donor=1e10
Interface3_interface_energy_level=Ev+1.93

*Interface 4: Cu2O/Au
Interface4_type=Neutral
Interface4_N_interface_donor=1e11

*================================================================================
* CONTACT PROPERTIES
*================================================================================
*Front contact work function
Phi_cont_l=4.4

*Back contact work function
Phi_cont_r=5.1

*================================================================================
* ILLUMINATION
*================================================================================
*Standard AM1.5G solar spectrum at 25°C
F_light=1
light=AM1.5G

*================================================================================
* VOLTAGE SWEEP SETTINGS
*================================================================================
Vstart=-0.5
Vstep=0.01
Vstop=1.2

*================================================================================
* END OF FILE
* Scientific Reference:
* Son, C.; Son, H.; Jeong, B.-S. Enhanced Conversion Efficiency in MAPbI3 
* Perovskite Solar Cells through Parameters Optimization via SCAPS-1D Simulation. 
* Appl. Sci. 2024, 14, 2390. https://doi.org/10.3390/app14062390
*================================================================================